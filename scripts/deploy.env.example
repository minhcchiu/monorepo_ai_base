# Cấu hình deploy cloudpulse — BẢN MẪU.
#
# Cách dùng:
#   cp scripts/deploy.env.example scripts/deploy.local.env
#   chmod 600 scripts/deploy.local.env
#   # rồi điền thông tin server vào deploy.local.env
#
# ⚠️ deploy.local.env đã được gitignore. TUYỆT ĐỐI không `git add -f` file đó.

# --- Kết nối SSH (bắt buộc) ---
SSH_HOST=
SSH_USER=root
SSH_PORT=22

# Private key dùng để đăng nhập. Để trống nếu đã cấu hình trong ~/.ssh/config
# hoặc đã nạp vào ssh-agent.
# Script KHÔNG hỗ trợ đăng nhập bằng mật khẩu. Nếu server mới chỉ có mật khẩu,
# cài key một lần:  ssh-copy-id -p <port> <user>@<host>
SSH_KEY=~/.ssh/id_ed25519

# --- Repo trên server (bắt buộc) ---
REMOTE_PATH=/home/cloudpulse
REPO_BRANCH=main

# --- Tên process PM2 (khớp ecosystem.config.js ở gốc repo) ---
PM2_BACKEND=cloudpulse-backend
PM2_ADMIN=cloudpulse-web-admin
