{
  "name": "cloudpulse",
  "version": "0.0.0",
  "private": true,
  "description": "CloudPulse — Modern Infrastructure Orchestrator (VPS, PM2, deployments, domains, backups, monitoring). Monorepo: backend NestJS, web + web-admin Next.js, mobile Android Kotlin, shared packages.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter @cloudpulse/backend",
    "dev:admin": "turbo run dev --filter @cloudpulse/admin",
    "dev:web": "turbo run dev --filter @cloudpulse/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "codegen": "turbo run codegen",
    "mobile": "cd apps/mobile && ./gradlew :app:installDebug"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "dependencies": {
    "@cloudpulse/config": "workspace:^",
    "@cloudpulse/ui": "workspace:^"
  }
}
