{
  "name": "pp09base",
  "version": "0.0.0",
  "private": true,
  "description": "Base monorepo (backend NestJS, web-admin Next.js, mobile Android Kotlin, shared packages).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter @pp09base/backend",
    "dev:admin": "turbo run dev --filter @pp09base/admin",
    "dev:web": "turbo run dev --filter @pp09base/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "codegen": "turbo run codegen",
    "mobile": "cd apps/mobile && ./gradlew :app:installDebug"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "dependencies": {
    "@pp09base/config": "workspace:^",
    "@pp09base/ui": "workspace:^"
  }
}
