# ============================================================================
# BACKEND ENV TEMPLATE — chỉ chứa PLACEHOLDER. KHÔNG điền secret thật vào file này.
# Copy sang `.env` (đã gitignore) rồi điền giá trị thật ở môi trường của bạn.
# ============================================================================

# Local Development Environment
NODE_ENV=development
APP_NAME="NestJS Backend"
APP_VERSION=1.0.0

# Server
PORT=3000

# Database (PostgreSQL) — dùng credential RIÊNG của bạn, không commit
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# JWT
JWT_SECRET=change-me-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=360d

# Security
BCRYPT_ROUNDS=10

# CORS (danh sách origin, phân tách bằng dấu phẩy; '*' chỉ dùng cho dev)
CORS_ORIGIN=*

# Base URL công khai của backend (dùng dựng URL file upload trả về client).
# Production: https://cloudpulse.izisoft.io — bỏ trống thì fallback về http://localhost:$PORT
PUBLIC_BASE_URL=

# Email (optional)
EMAIL_FROM=dev@localhost
EMAIL_PROVIDER=smtp

# Redis (optional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=debug

# API
API_PREFIX=api
API_VERSION=v1

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PRIMARY_COLOR=#FF5A5F
# Bảo vệ /docs ở production (Basic Auth)
SWAGGER_USER=
SWAGGER_PASS=

# Sentry (để trống = tắt Sentry; KHÔNG hardcode DSN trong source)
SENTRY_DSN=

# Firebase (chọn 1: JSON trực tiếp hoặc base64). Để trống nếu FIREBASE_ENABLED=false
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# OTP / Zalo ZNS qua eSMS — điền key thật ở .env, KHÔNG commit
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_ENDPOINT=https://rest.esms.vn/MainService.svc/json/SendZaloMessage_V6/
ESMS_OAID=
ESMS_TEMP_ID=
ESMS_SENDING_MODE=1
ESMS_CALLBACK_URL=

# Google Play — verify IAP subscription (secrets/README.md hướng dẫn tạo service account)
GOOGLE_PLAY_PACKAGE_NAME=com.izisoft.pp09base
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-play-service-account.json

# API request log — bật để ghi mọi HTTP request vào bảng ApiRequestLog
API_LOG_ENABLED=false
API_LOG_RETENTION_DAYS=7
API_LOG_CLEANUP_INTERVAL_MINUTES=60
