    <string name="profile_help_header">How can we help?</string>
    <string name="profile_help_step1_title">1. Start a new scan</string>
    <string name="profile_help_step1_content">From Home, tap Scan and point the camera at your rock or mineral sample. Keep the specimen in focus and use good lighting for better results.</string>
    <string name="profile_help_step2_title">2. Improve scan accuracy</string>
    <string name="profile_help_step2_content">Clean the specimen surface, place it on a plain background, and avoid reflections. Try multiple angles if the first result is unclear.</string>
    <string name="profile_help_step3_title">3. Manage collections</string>
    <string name="profile_help_step3_content">Open Collections to group scans by project, location, or type. You can add new folders and revisit saved identifications any time.</string>
    <string name="profile_help_step4_title">4. Billing and subscription</string>
    <string name="profile_help_step4_content">Use Restore Purchase from Profile if you changed device or reinstalled the app. For plan updates, open your store subscription settings.</string>
    <string name="profile_help_step5_title">5. Need more support?</string>
    <string name="profile_help_step5_content">Send feedback to support@pp09base.example.com with app version, device model, and a short description so we can help faster.</string>

    <string name="profile_privacy_header">Your privacy matters</string>
    <string name="profile_privacy_info_title">Information we collect</string>
    <string name="profile_privacy_info_content">We may collect account details, scan metadata, and app diagnostics to deliver identification results and improve reliability.</string>
    <string name="profile_privacy_usage_title">How we use data</string>
    <string name="profile_privacy_usage_content">Your data is used to provide scan analysis, sync your account across devices, and maintain subscription features.</string>
    <string name="profile_privacy_sharing_title">Data sharing</string>
    <string name="profile_privacy_sharing_content">We do not sell your personal data. Limited sharing with trusted service providers may occur to operate payments, analytics, and cloud storage.</string>
    <string name="profile_privacy_retention_title">Retention and deletion</string>
    <string name="profile_privacy_retention_content">We keep data only as long as needed for service operation or legal obligations. You can request deletion by contacting support@pp09base.example.com.</string>
    <string name="profile_privacy_contact_title">Contact</string>
    <string name="profile_privacy_contact_content">If you have privacy questions, contact us at privacy@pp09base.example.com. We may update this policy as features evolve.</string>

